
<!DOCTYPE html>
<html>
<head>
<title>Retro Football</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body {
  background: #172b20;
  color: white;
  text-align: center;
  font-family: Arial;
}
canvas {
  background: #398b43;
  border: 4px solid white;
  max-width: 95%;
}
button {
  padding: 14px 25px;
  margin: 8px;
  font-size: 18px;
  border-radius: 8px;
}
</style>
</head>
<body>

<h1>🏈 RETRO FOOTBALL</h1>
<h2>Score: <span id="score">0</span></h2>

<canvas id="game" width="600" height="400"></canvas>

<p>Move with arrow keys or WASD. Avoid defenders!</p>
<button onclick="start()">START GAME</button>
<button onclick="throwBall()">THROW!</button>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

let player = {x:70, y:200, size:20};
let defenders = [];
let score = 0;
let running = false;
let keys = {};

function start() {
  player = {x:70,y:200,size:20};
  defenders = [
    {x:280,y:100},
    {x:380,y:270},
    {x:470,y:170}
  ];
  score = 0;
  running = true;
  document.getElementById("score").textContent = score;
}

document.addEventListener("keydown", e => {
  keys[e.key.toLowerCase()] = true;
});
document.addEventListener("keyup", e => {
  keys[e.key.toLowerCase()] = false;
});

function throwBall() {
  if (!running) return;
  player.x += 70;
  score += 1;
  document.getElementById("score").textContent = score;
  if (player.x > 550) {
    score += 5;
    document.getElementById("score").textContent = score;
    running = false;
    alert("TOUCHDOWN! 🏈");
  }
}

function update() {
  if (running) {
    if (keys["arrowup"] || keys["w"]) player.y -= 4;
    if (keys["arrowdown"] || keys["s"]) player.y += 4;
    if (keys["arrowright"] || keys["d"]) player.x += 3;
    if (keys["arrowleft"] || keys["a"]) player.x -= 3;

    player.x = Math.max(10,Math.min(570,player.x));
    player.y = Math.max(10,Math.min(370,player.y));

    defenders.forEach(d => {
      let dx = player.x-d.x;
      let dy = player.y-d.y;
      let distance = Math.sqrt(dx*dx+dy*dy);

      if(distance > 1) {
        d.x += dx/distance*1.2;
        d.y += dy/distance*1.2;
      }

      if(distance < 25) {
        running = false;
        alert("TACKLED! Final score: " + score);
      }
    });
  }
}

function draw() {
  ctx.clearRect(0,0,600,400);

  ctx.strokeStyle="white";
  ctx.lineWidth=2;

  for(let x=0;x<600;x+=60) {
    ctx.beginPath();
    ctx.moveTo(x,0);
    ctx.lineTo(x,400);
    ctx.stroke();
  }

  ctx.fillStyle="white";
  ctx.font="20px Arial";
  ctx.fillText("END ZONE",520,30);

  ctx.fillStyle="#ffd43b";
  ctx.fillRect(player.x,player.y,20,20);

  ctx.fillStyle="#e33b35";
  defenders.forEach(d=>{
    ctx.fillRect(d.x,d.y,20,20);
  });

  ctx.fillStyle="white";
  ctx.fillText("YOU",player.x-5,player.y-10);
}

function loop() {
  update();
  draw();
  requestAnimationFrame(loop);
}

loop();
</script>
</body>
</html>
